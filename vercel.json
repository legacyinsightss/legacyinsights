{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "*.css",
          "*.png",
          "*.ico",
          "auth-guard.js",
          "currency.js",
          "instant-nav.js",
          "telemetry-guard.js",
          "offline-queue.js",
          "user-session.js",
          "sw.js"
        ]
      }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/server.js" }
  ]
}